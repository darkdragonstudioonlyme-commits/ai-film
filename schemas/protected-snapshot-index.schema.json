{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protected snapshot index envelope, not complete E00 field catalogs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "relative_path",
          "record_id",
          "bytes",
          "sha256"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^E00-(0[1-9]|1[0-5])$"
          },
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10485760
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
