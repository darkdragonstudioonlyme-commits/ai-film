{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Detached-approval plan envelope",
  "properties": {
    "semantic": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "title": "Phase00 binding v1 (draft application schema, partial adapters)",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "work_item": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "execution_class": {
          "enum": [
            "LAB",
            "SITE"
          ]
        },
        "host_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "owner_sid": {
          "type": "string",
          "pattern": "^S-1-[0-9-]+$"
        },
        "target": {
          "type": "object",
          "required": [
            "name",
            "base_path",
            "registration_id",
            "user"
          ],
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "base_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "registration_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "user": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "purpose": {
          "enum": [
            "PASSIVE",
            "DISCOVERY",
            "ENGINE",
            "CREATE",
            "ADOPT",
            "RESTORE_EXPORT",
            "RESTORE_IMPORT",
            "SITE_VERIFY",
            "TARGET_LIFECYCLE",
            "HOST_RESTART",
            "RESTORE_VERIFY",
            "RECONCILIATION_ONLY",
            "SUPPORT_BUNDLE"
          ]
        },
        "contract_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "build_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "test_set_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile": {
          "type": "object"
        },
        "before": {
          "type": "object"
        },
        "expected_after": {
          "type": "object"
        },
        "budgets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "volume_id",
              "roles",
              "allocations"
            ],
            "properties": {
              "volume_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "roles": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "OS",
                    "DISTRO",
                    "EVIDENCE",
                    "BACKUP"
                  ]
                }
              },
              "allocations": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "additionalProperties": false
          }
        },
        "payload_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_class": {
          "enum": [
            "NOT_YET_CREATED",
            "CLEAN_P00",
            "ADOPT_NONSENSITIVE_QUIESCED",
            "SYNTHETIC_LAB",
            "UNKNOWN",
            "SENSITIVE"
          ]
        },
        "refs": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "final_state": {
          "enum": [
            "RUNNING",
            "STOPPED_RETAINED",
            "OPERATOR_PENDING"
          ]
        },
        "endpoints": {
          "type": "array"
        },
        "bundle_scope": {
          "enum": [
            "INVENTORY",
            "FAILED_RUN",
            "GATE_HANDOFF"
          ]
        },
        "expected_checkpoint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expected_envelope": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scratch_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "class": {
                "enum": [
                  "C0",
                  "C1",
                  "C2",
                  "C3"
                ]
              }
            },
            "required": [
              "action",
              "class"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "work_item",
        "execution_class",
        "host_id",
        "owner_sid",
        "target",
        "purpose",
        "contract_digest",
        "build_digest",
        "test_set_digest",
        "profile",
        "before",
        "expected_after",
        "budgets",
        "payload_digest",
        "source_class",
        "refs",
        "final_state",
        "operations"
      ],
      "additionalProperties": false
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "report": {
      "type": "object",
      "required": [
        "created_at"
      ],
      "properties": {
        "created_at": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "approval_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "semantic",
    "plan_digest",
    "report"
  ],
  "additionalProperties": false
}
