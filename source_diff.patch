@@ -0,0 +1,193 @@
+"""Reviewed Phase00 native acceptance procedure catalog.
+
+This module is a controller specification, not evidence that any case ran. Every
+procedure uses fixed preparation/action/oracle enums; arbitrary shell commands,
+caller-provided expected results and fixture flags are forbidden. Runtime case
+closure still requires registered native LAB/SITE execution plus journal/evidence
+oracles in harness_controller.py.
+"""
+from dataclasses import dataclass
+from ..codec import digest
+from ..errors import require
+
+ENVIRONMENTS=frozenset({'DOCUMENT','LAB','LAB_SITE'})
+ROUTES=frozenset({'PASSIVE','DISCOVERY','ENGINE','CREATE','ADOPT','RESTORE_EXPORT',
+ 'RESTORE_IMPORT','SITE_VERIFY','TARGET_LIFECYCLE','HOST_RESTART','RESTORE_VERIFY',
+ 'RECONCILIATION_ONLY','SUPPORT_BUNDLE','ENTRY_ONLY'})
+PREPARATIONS=frozenset({
+ 'EXACT_REVIEW_SET','MATCHING_PROFILE','PROFILE_MISMATCH','RESOURCE_BOUNDARY_MATRIX',
+ 'NETWORK_CONTEXT_MATRIX','STANDARD_LIFECYCLE','STAGED_CONFIG_INACTIVE','NETWORK_BOUNDARY_CHANGE',
+ 'PLANNED_ENGINE_TRANSITION','MISSED_EPOCH_WITNESS','STALE_TERMINAL_CLOCK','STOPPED_TARGET',
+ 'ACTIVE_GUARD_HOLDER','CROSS_SCOPE_HOLDER','SHARED_VOLUME_PRESSURE','CROSS_SID_HOLDER',
+ 'NATIVE_TIMEOUT','ABANDONED_GUARD','POST_REGISTRATION_CRASH','SOURCE_DESTINATION_RESTORE',
+ 'JOURNAL_WRITE_FAILURE','BUNDLE_COMPLETE','OPTIONAL_COLLECTOR_FAILURE','MANDATORY_COLLECTOR_FAILURE',
+ 'OPTIONAL_CAP','MANDATORY_CAP','NESTED_SECRET_CANARY','REDACTION_RESIDUAL','MULTI_FAILURE_PRIVACY',
+ 'BUNDLE_HASH_TAMPER','OUTPUT_PUBLISH_FAILURE','PRECREATE_INVENTORY','FAILED_RUN_EVIDENCE',
+ 'PATH_ESCAPE','GATE_ASSESSMENT_BOUNDARY','CLEAN_RESTORE_SOURCE','ADOPT_RESTORE_SOURCE',
+ 'ISOLATION_MISSING','SYNTHETIC_ISOLATION_CANARY','ISOLATION_DRIFT','SAME_HOST_DIRTY',
+ 'SENSITIVE_SOURCE','CHECKPOINT_TAMPER','RETAINED_CAPACITY_PRESSURE','VERIFY_MUTATION_REQUEST',
+ 'COEXISTING_RESOURCE','CREATE_CLEAN_HOST','ADOPT_ELIGIBLE','ENGINE_CLEAN_HOST','PROTECTION_MISSING',
+ 'RECOVERY_DEPENDS_ON_SOURCE','CONSISTENCY_BOUNDARY_DRIFT','C3_CRASH','OWNER_POSTCHECK_MISSING',
+ 'EXISTING_TARGET_PROTECTION','QUALIFICATION_MISSING','QUALIFICATION_INVALID','QUALIFICATION_MISMATCH',
+ 'TRUST_FORGERY','REGISTERED_DISPOSABLE_LAB','SITE_FAKE_LAB','DISCOVERY_UNKNOWN_GUEST',
+ 'ENGINE_ABSENT_PROFILE','APPROVAL_EXPIRES_ON_RESUME','VIRTUALIZATION_BLOCKED','WRONG_ACTOR',
+ 'COLLISION_OR_PATH_ATTACK','UNSUPPORTED_PROFILE','RESOURCE_FLOOR_FAILURE','NETWORK_FAILURE',
+ 'TRUST_FAILURE','MATERIAL_DRIFT','CONCURRENCY_OR_CRASH','REBOOT_OOBE_WAIT','C3_PROTECTION_FAILURE',
+ 'RESTORE_FAILURE','EVIDENCE_FAILURE','PASSIVE_UNKNOWN_GUEST','GLOBAL_POLICY_DRIFT','JOURNAL_IO_FAILURE'})
+ACTIONS=frozenset({'REVIEW_EXACT_CONTENT','INVOKE_PRODUCTION_REQUEST','INVOKE_CONTENDER',
+ 'RESUME_OR_RECONCILE','RUN_TERMINAL_SWEEP','RUN_SUPPORT_BUNDLE','RUN_RESTORE_SEQUENCE',
+ 'RUN_OWNER_LIFECYCLE','OBSERVE_ONLY','VERIFY_ENTRY_REJECTION','VERIFY_EVIDENCE_OUTPUT',
+ 'VERIFY_ISOLATION','VERIFY_PROTECTION','VERIFY_CONCURRENCY_TRACE','VERIFY_NO_MUTATION'})
+ORACLES=frozenset({'EXACT_CONTENT_IDENTITY','IDENTITY_PROFILE','RESOURCE_CAPACITY','NETWORK_MATRIX',
+ 'LIFECYCLE_EPOCH','PASSIVE_NO_LAUNCH','JOURNAL_NO_OVERLAP','BUNDLE_OUTCOME','RESTORE_CONTENT',
+ 'COEXISTENCE_HEALTH','CREATE_ROUTE','ADOPT_ROUTE','C3_PROTECTION','ENTRY_GATE',
+ 'EXPECTED_REJECTION','DURABLE_WAIT','UNCERTAIN_RETAINED','RECONCILIATION_ONLY','NO_DUPLICATE_MUTATION',
+ 'PRIVACY_NO_OUTPUT','OUTPUT_INTEGRITY','OUTPUT_RECOVERY','EVIDENCE_REQUIREDNESS','ISOLATION_BOUNDARY',
+ 'CHECKPOINT_INTEGRITY','CAPACITY_REMEASURE','PURPOSE_SEPARATION','TERMINAL_FRESHNESS','NO_POLICY_WEAKENING',
+ 'QUALIFICATION_SCOPE','NO_PROCESS_EXIT_PROOF','PROTECTED_EVIDENCE','VERIFY_NO_MUTATION','COEXISTENCE_HEALTH'})
+
+@dataclass(frozen=True)
+class NativeCaseProcedure:
+    case_id:str
+    environment:str
+    preparations:tuple[str,...]
+    routes:tuple[str,...]
+    controller_steps:tuple[str,...]
+    expected_exits:tuple[int,...]
+    oracles:tuple[str,...]
+    required_evidence:tuple[str,...]
+    destructive:bool=False
+    actual_native_required:bool=True
+
+    def document(self):
