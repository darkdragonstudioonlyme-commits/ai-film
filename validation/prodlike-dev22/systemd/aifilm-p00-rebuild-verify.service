[Unit]
Description=AI-FILM Phase00 current NTFS rebuild-set cold verification
After=default.target

[Service]
Type=oneshot
ExecStart=/home/dragon/ai-film-runtime/bin/verify-rebuild-set.py --cold-probe
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/dragon/ai-film-runtime/state-snapshots
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
