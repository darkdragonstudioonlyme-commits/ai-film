[Unit]
Description=AI-FILM Phase00 mirror verified control backup to Windows host
After=default.target

[Service]
Type=oneshot
ExecStart=/home/dragon/ai-film-runtime/bin/mirror-control-backup.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/c/Users/Admin/AppData/Local/AI-FILM/runtime-backups
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=journal
