[Unit]
Description=AI-FILM Phase00 current transfer-ready DR export
After=aifilm-p00-control-backup.service aifilm-p00-rebuild-verify.service

[Service]
Type=oneshot
ExecStart=/home/dragon/ai-film-runtime/bin/build-offhost-export.py
ExecStart=/home/dragon/ai-film-runtime/bin/verify-offhost-export.py --drill
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/c/Users/Admin/AppData/Local/AI-FILM/offhost-export
ReadWritePaths=/home/dragon/ai-film-runtime/state-snapshots
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=journal
